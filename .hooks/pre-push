#!/usr/bin/env bash
# DO NOT EDIT — generated from src/domain/blueprints/pre-push.ts; run `claude-factory work commit` to refresh

set -euo pipefail

if [[ "${SKIP_GUARD:-0}" == "1" ]]; then
  exit 0
fi

resolve_toolchain_bin() {
  while IFS= read -r c; do
    case "$c" in
      */node_modules/*) continue ;;
      *) printf '%s\n' "$c"; return 0 ;;
    esac
  done < <(type -aP "$1" 2>/dev/null)
  return 1
}

if hook_bin="$(resolve_toolchain_bin claude-factory)"; then
  exec "${hook_bin}" hook git pre-push "$@"
fi

if [[ -z "$(git ls-files -- .hooks/pre-push guard.json 2>/dev/null)" ]]; then
  exit 0
fi

echo "claude-factory was not found on PATH (excluding node_modules). Enter the project dev shell, which provisions it: run \`nix develop\` from the repository root (or re-enter your configured dev shell)." >&2
echo "From inside the dev shell, re-run \`claude-factory work commit \"<your-message>\"\`." >&2
echo "If this environment cannot provide it, push with SKIP_GUARD=1 set and re-validate from an environment that can." >&2
exit 1
