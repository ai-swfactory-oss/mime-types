# DO NOT EDIT — generated from src/blueprints/envrc.ts; run `claude-factory work commit` to refresh
watch_file flake.nix
watch_file flake.lock

__envrc_digest() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi
}

__envrc_key="$(cat flake.nix flake.lock 2>/dev/null | __envrc_digest 2>/dev/null | cut -d' ' -f1)"
__envrc_snapshot="${XDG_CACHE_HOME:-$HOME/.cache}/nix-dev-env/${__envrc_key}.sh"

if [ -n "${__envrc_key}" ] && [ ! -s "${__envrc_snapshot}" ]; then
  mkdir -p "$(dirname "${__envrc_snapshot}")"
  if nix print-dev-env --no-warn-dirty . > "${__envrc_snapshot}.tmp" 2>/dev/null; then
    mv -f "${__envrc_snapshot}.tmp" "${__envrc_snapshot}"
  else
    rm -f "${__envrc_snapshot}.tmp"
  fi
fi

if [ -n "${__envrc_key}" ] && [ -s "${__envrc_snapshot}" ]; then
  . "${__envrc_snapshot}"
else
  use flake
fi

unset -f __envrc_digest
