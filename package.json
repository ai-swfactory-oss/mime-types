{
  "name": "@ai-swfactory/mime-types",
  "version": "1.1.2",
  "description": "TypeScript MIME type database and utilities with full type inference",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-swfactory/mime-types.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "restricted"
  },
  "packageManager": "pnpm@10.2.1",
  "scripts": {
    "lint": "eslint",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@ai-swfactory/panoptic-presets": "^17.0.0",
    "@ai-swfactory/seams": "^14.0.1",
    "@ai-swfactory/seams-node": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.0.4",
    "eslint": "^10.0.0",
    "jiti": "^2.4.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4",
    "typescript-eslint": ">=8.0.0",
    "zod": "^4.4.3"
  }
}
