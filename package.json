{
  "name": "@ai-swfactory/mime-types",
  "version": "1.1.1",
  "description": "TypeScript MIME type database and utilities with full type inference",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-swfactory/mime-types.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "restricted"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "panoptic-build",
    "lint": "eslint",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "release": "panoptic-release",
    "guard:run": "panoptic-guard run"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@ai-swfactory/panoptic-presets": "^16.1.1",
    "@ai-swfactory/panoptic-release": "^3.1.0",
    "@ai-swfactory/rollup-plugins": "^3.4.7",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.0.4",
    "eslint": "^10.0.0",
    "jiti": "^2.4.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4",
    "typescript-eslint": ">=8.0.0",
    "@ai-swfactory/bash-test-kit": ">=1.0.0"
  }
}
